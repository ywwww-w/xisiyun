# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
# Also catch scripts_tmp/ bytecode explicitly (not strictly needed, but clarity)
scripts_tmp/**/__pycache__/
scripts_tmp/**/*.pyc

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
eggs/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env

# Test cache / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Uploads / logs (keep .gitkeep)
uploads/*
!uploads/.gitkeep
logs/*
!logs/.gitkeep

# Temp scripts assets (large binary files)
scripts_tmp/test_assets/51mb_*.mp3
scripts_tmp/test_assets/*.bin
# General large binary > 100MB that should never be committed
*.100mb+
*.iso
*.zip
scripts_tmp/test_assets/large_*
